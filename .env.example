# Copy to .env and fill in. Never commit .env.
# Every setting is an environment variable; there is no config file.

# --- Game server (required) -------------------------------------------------
# The panel and the game server may be on different hosts.
SDTD_HOST=10.0.0.5
SDTD_API_PORT=8080
# Set to https only if the game server's web API is behind TLS.
SDTD_API_SCHEME=http

# Create these with the `webtokens` console command on the game server.
# This token grants full administrative control — treat it as a root password.
SDTD_API_TOKEN_NAME=panel
SDTD_API_TOKEN_SECRET=

# --- Panel admin (required) ------------------------------------------------
# Reconciled into the database on every boot, so changing this and
# restarting resets the password. There is no password change in the UI.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=

# --- Panel (optional, sane defaults) ---------------------------------------
PANEL_PORT=8080
PANEL_DB_PATH=/data/panel.db
PANEL_SESSION_TTL=168h

# Trust X-Forwarded-Proto to decide whether to set Secure on the session
# cookie. Enable only when the panel actually sits behind a reverse proxy.
PANEL_TRUST_PROXY=false

PANEL_POLL_INTERVAL=5s
# Consecutive failed polls before the server is declared offline. A single
# failed poll never blanks state or flips the status badge.
PANEL_FAILURE_THRESHOLD=3

# Set false to block world-destroying commands (regionreset,
# worldchunkreset) outright, regardless of confirmation.
PANEL_ALLOW_DESTRUCTIVE=true

PANEL_LOG_LEVEL=info
PANEL_LOG_FORMAT=json
TZ=UTC
