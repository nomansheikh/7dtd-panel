# Build output
/dist/
/7dtd-panel
/specbundle
*.exe

# Frontend build output is embedded at build time, never committed. The
# .gitkeep keeps the go:embed pattern satisfied on a clean checkout.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Dependencies
/node_modules/
/web/node_modules/

# Local runtime data
/data/
*.db
*.db-shm
*.db-wal

# Secrets — the API token and admin password live here, never in git
.env
.env.*
!.env.example

# Go
*.test
/coverage.out

# Local scratch
/.screenshots/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Scratch space for browser snapshots taken while verifying.
.tmp-verify/
